<?xml version="1.0" encoding="UTF-8"?>
<!-- EXAMPLE FILE PUF Invoice Response. Türkiye. Use Case: response received Supplier <- Pagero <- QNB eSolutions <- GİB <- Buyer.
	The buyer rejected a TİCARİ e-Fatura with a UBL-TR 1.2 uygulama yanıtı carrying cbc:ResponseCode RED.
	The reason for the rejection is in cbc:Note, where GİB requires it. -->
<ApplicationResponse xmlns="urn:oasis:names:specification:ubl:schema:xsd:ApplicationResponse-2"
	xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
	xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2"
	xmlns:ext="urn:oasis:names:specification:ubl:schema:xsd:CommonExtensionComponents-2"
	xmlns:puf="urn:pagero:ExtensionComponent:1.0">
	<!-- Specification Identifier -->
	<cbc:CustomizationID>urn:pagero.com:puf:invoice_response:1.0</cbc:CustomizationID>
	<!-- Business process type identifier -->
	<cbc:ProfileID>urn:pagero.com:puf:invoice_response:1.0</cbc:ProfileID>
	<!-- Response identifier. GİB requires a three letter unit code followed by a 13 digit serial number,
		whose first four digits are the year the response was issued. -->
	<cbc:ID>BBB2026000000002</cbc:ID>
	<!-- Response issue date -->
	<cbc:IssueDate>2026-09-21</cbc:IssueDate>
	<!-- Response issue time -->
	<cbc:IssueTime>14:42:00</cbc:IssueTime>
	<!-- General note. GİB requires the reason for the rejection to be stated in the general
		notes of the uygulama yanıtı (UBL-TR Ticari Fatura Senaryosu v0.3, case B). -->
	<cbc:Note>Fatura, satış anlaşmasına uygun fiyatlandırılmaması nedeniyle reddedilmiştir.</cbc:Note>
	<!-- Sender Party. The buyer, who issues the uygulama yanıtı. -->
	<cac:SenderParty>
		<!-- Vergi Kimlik Numarası of the buyer. Reaches the UBL-TR target as
			cac:PartyIdentification/cbc:ID with schemeID "VKN". -->
		<cac:PartyIdentification>
			<cbc:ID schemeID="TR:VKN">9205121120</cbc:ID>
		</cac:PartyIdentification>
		<cac:PartyLegalEntity>
			<!-- Party name -->
			<cbc:RegistrationName>BBB Limited Şirketi</cbc:RegistrationName>
		</cac:PartyLegalEntity>
		<!-- Contact information -->
		<cac:Contact>
			<cbc:Name>Muhasebe</cbc:Name>
			<cbc:Telephone>(312) 621 1111</cbc:Telephone>
			<cbc:ElectronicMail>bb@bbb.com.tr</cbc:ElectronicMail>
		</cac:Contact>
	</cac:SenderParty>
	<!-- Receiver Party. The supplier that issued the invoice being responded to. -->
	<cac:ReceiverParty>
		<!-- Vergi Kimlik Numarası of the supplier -->
		<cac:PartyIdentification>
			<cbc:ID schemeID="TR:VKN">1288331521</cbc:ID>
		</cac:PartyIdentification>
		<cac:PartyLegalEntity>
			<!-- Party name -->
			<cbc:RegistrationName>AAA Anonim Şirketi</cbc:RegistrationName>
		</cac:PartyLegalEntity>
	</cac:ReceiverParty>
	<!-- Document Response -->
	<cac:DocumentResponse>
		<!-- Response -->
		<cac:Response>
			<ext:UBLExtensions>
				<ext:UBLExtension>
					<ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:ResponseExtension</ext:ExtensionURI>
					<ext:ExtensionContent>
						<puf:PageroExtension>
							<puf:ResponseExtension>
								<!-- The interchange id of the invoice this response answers, supplied by Pagero Online
									when the response is matched to the sent e-Fatura. -->
								<puf:ReferencedDocumentInterchangeID>
									<cbc:ID>111222333</cbc:ID>
								</puf:ReferencedDocumentInterchangeID>
							</puf:ResponseExtension>
						</puf:PageroExtension>
					</ext:ExtensionContent>
				</ext:UBLExtension>
			</ext:UBLExtensions>
			<!-- Identifier of this response entry. UBL-TR makes cac:Response/cbc:ReferenceID mandatory. -->
			<cbc:ReferenceID>BBB2026000000002-1</cbc:ReferenceID>
			<!-- Response code. RED in the received uygulama yanıtı maps to RE. Only KABUL and RED are supported; the third UBL-TR value
				IADE belongs to the return invoice process and has no PUF equivalent. -->
			<cbc:ResponseCode>RE</cbc:ResponseCode>
			<!-- Status carried over from the received uygulama yanıtı: its response code and cac:Response/cbc:Description. -->
			<cac:Status>
				<cbc:StatusReasonCode listID="OPStatusReason">OTH</cbc:StatusReasonCode>
				<cbc:StatusReason>RED: FATURARED</cbc:StatusReason>
			</cac:Status>
		</cac:Response>
		<!-- Document Reference -->
		<cac:DocumentReference>
			<!-- Invoice number of the referenced e-Fatura,
				resolved by Pagero Online from the referenced document -->
			<cbc:ID>AAA2026000000011</cbc:ID>
			<!-- Issue date of the referenced e-Fatura -->
			<cbc:IssueDate>2026-09-18</cbc:IssueDate>
		</cac:DocumentReference>
	</cac:DocumentResponse>
</ApplicationResponse>
